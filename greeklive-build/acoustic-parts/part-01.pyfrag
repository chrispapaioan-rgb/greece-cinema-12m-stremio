SOURCES['SpeakerTurnTracker.kt'] = 'package com.xyq.livetranslate\n\nimport kotlin.math.sqrt\n\n/**\n * Online, identity-free speaker clustering. Labels are ephemeral per session.\n */\nclass SpeakerTurnTracker(\n    private val knownMatchThreshold: Float = 0.53f,\n    private val newSpeakerConsistencyThreshold: Float = 0.67f,\n    private val confirmationsRequired: Int = 2,\n    private val centroidEma: Float = 0.18f,\n) {\n    sealed interface Result {\n        data class Initial(val speakerId: String) : Result\n        data class Same(val speakerId: String, val similarity: Float) : Result\n        data class Pending(val candidateId: String?, val count: Int, val similarity: Float) : Result\n        data class Switched(val from: String, val to: String, val similarity: Float) : Result\n    }\n\n    private val centroids = LinkedHashMap<String, FloatArray>()\n    private var nextSpeaker = 1\n    private var activeId: String? = null\n    private var pendingKnownId: String? = null\n    private var pendingUnknown: FloatArray? = null\n    private var pendingCount = 0\n\n    fun currentSpeaker(): String? = activeId\n    fun speakerCount(): Int = centroids.size\n\n    fun reset() {\n        centroids.clear()\n        nextSpeaker = 1\n        activeId = null\n        clearPending()\n    }\n\n    fun observe(raw: FloatArray): Result {\n        require(raw.isNotEmpty())\n        val embedding = normalized(raw)\n        val active = activeId\n        if (active == null) {\n            val id = createSpeaker(embedding)\n            activeId = id\n            return Result.Initial(id)\n        }\n\n        val match = bestKnownMatch(embedding)\n        if (match != null && match.second >= knownMatchThreshold) {\n            val (matchedId, sim) = match\n            if (matchedId == active) {\n                updateCentroid(active, embedding)\n                clearPending()\n                return Result.Same(active, sim)\n            }\n            if (pendingKnownId == matchedId) pendingCount++ else {\n                pendingKnownId = matchedId\n                pendingUnknown = null\n                pendingCount = 1\n            }\n            if (pendingCount >= confirmationsRequired) {\n                val from = active\n                activeId = matchedId\n                updateCentroid(matchedId, embedding)\n                clearPending()\n                return Result.Switched(from, matchedId, sim)\n            }\n            return Result.Pending(matchedId, pendingCount, sim)\n        }\n\n        val previousUnknown = pendingUnknown\n        val consistency = if (previousUnknown == null) -1f else cosine(previousUnknown, embedding)\n        if (previousUnknown != null && consistency >= newSpeakerConsistencyThreshold && pendingKnownId == null) {\n            pendingCount++\n            pendingUnknown = mean(previousUnknown, embedding)\n        } else {\n            pendingKnownId = null\n            pendingUnknown = embedding\n            pendingCount = 1\n        }\n\n        if (pendingCount >= confirmationsRequired) {\n            val from = active\n            val id = createSpeaker(pendingUnknown ?: embedding)\n            activeId = id\n            clearPending()\n            return Result.Switched(from, id, consistency.coerceAtLeast(0f))\n        }\n        return Result.Pending(null, pendingCount, consistency.coerceAtLeast(0f))\n    }\n\n    private fun createSpeaker(e: FloatArray): String {\n        val id = "spk_${nextSpeaker++}"\n        centroids[id] = e.copyOf()\n        return id\n    }\n\n    private fun bestKnownMatch(e: FloatArray): Pair<String, Float>? {\n        var bestId: String? = null\n        var best = -1f\n        for ((id, c) in centroids) {\n            val s = cosine(c, e)\n            if (s > best) { best = s; bestId = id }\n        }\n        return bestId?.let { it to best }\n    }\n\n    private fun updateCentroid(id: String, e: FloatArray) {\n        val old = centroids[id] ?: return\n        val a = centroidEma.coerceIn(0.01f, 0.5f)\n        val out = FloatArray(old.size)\n        for (i in old.indices) out[i] = old[i] * (1f - a) + e[i] * a\n        centroids[id] = normalized(out)\n    }\n\n    private fun clearPending() {\n        pendingKnownId = null\n        pendingUnknown = null\n        pendingCount = 0\n    }\n\n    companion object {\n        fun cosine(a: FloatArray, b: FloatArray): Float {\n            if (a.size != b.size || a.isEmpty()) return -1f\n            var dot = 0.0; var aa = 0.0; var bb = 0.0\n            for (i in a.indices) { dot += a[i] * b[i]; aa += a[i] * a[i]; bb += b[i] * b[i] }\n            if (aa <= 1e-12 || bb <= 1e-12) return -1f\n            return (dot / sqrt(aa * bb)).toFloat()\n        }\n\n        private fun normalized(a: FloatArray): FloatArray {\n            var ss = 0.0\n            for (v in a) ss += v * v\n            val n = sqrt(ss).toFloat()\n            if (n <= 1e-6f) return a.copyOf()\n            return FloatArray(a.size) { i -> a[i] / n }\n        }\n\n        private fun mean(a: FloatArray, b: FloatArray): FloatArray {\n            val out = FloatArray(a.size)\n            for (i in a.indices) out[i] = (a[i] + b[i]) * 0.5f\n            return normalized(out)\n        }\n    }\n}\n'
