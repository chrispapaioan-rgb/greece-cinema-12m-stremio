
# --- Hard MediaProjection consent bridge + faster TV first frame.
manifest = app / 'src/main/AndroidManifest.xml'
s = manifest.read_text()

activity_anchor = '''        <activity
            android:name=".MainActivity"
'''
bridge_decl = '''        <activity
            android:name=".ProjectionConsentActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.LiveTranslate" />

'''
if activity_anchor not in s:
    die('MainActivity manifest anchor missing')
s = s.replace(activity_anchor, bridge_decl + activity_anchor, 1)
manifest.write_text(s, encoding='utf-8')

# Dedicated foreground Activity that launches the platform capture-consent UI only after it is
# fully resumed. This avoids OEM/TV lifecycle races when launching MediaProjection directly from
# onResume after returning from overlay settings.
bridge = pkg / 'ProjectionConsentActivity.kt'
bridge.write_text(r'''package com.xyq.livetranslate

import android.app.Activity
import android.content.Intent
import android.media.projection.MediaProjectionConfig
import android.media.projection.MediaProjectionManager
import android.os.Build
import android.os.Bundle
import android.widget.TextView

class ProjectionConsentActivity : Activity() {
    private var launched = false

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        launched = savedInstanceState?.getBoolean(STATE_LAUNCHED, false) == true

        // Visible fallback instead of a black/blank bridge if the system picker takes a moment.
        setContentView(
            TextView(this).apply {
                text = "Choose the app to share"
                textSize = 22f
                gravity = android.view.Gravity.CENTER
                setTextColor(android.graphics.Color.BLACK)
                setBackgroundColor(android.graphics.Color.WHITE)
            }
        )
    }

    override fun onPostResume() {
        super.onPostResume()
        if (launched) return
        launched = true

        val manager = getSystemService(MediaProjectionManager::class.java)
        val request = if (Build.VERSION.SDK_INT >= 34) {
            manager.createScreenCaptureIntent(
                MediaProjectionConfig.createConfigForUserChoice()
            )
        } else {
            manager.createScreenCaptureIntent()
        }

        try {
            @Suppress("DEPRECATION")
            startActivityForResult(request, REQUEST_MEDIA_PROJECTION)
        } catch (_: Throwable) {
            setResult(RESULT_CANCELED)
            finish()
        }
    }

    @Deprecated("Deprecated in Android SDK, intentionally used as the platform MediaProjection bridge")
    override fun onActivityResult(requestCode: Int, resultCode: Int, data: Intent?) {
        super.onActivityResult(requestCode, resultCode, data)
        if (requestCode != REQUEST_MEDIA_PROJECTION) return

        // Pass the REAL platform result through untouched. CaptureService is never started here.
        setResult(resultCode, data)
        finish()
    }

    override fun onSaveInstanceState(outState: Bundle) {
        outState.putBoolean(STATE_LAUNCHED, launched)
        super.onSaveInstanceState(outState)
    }

    companion object {
        private const val REQUEST_MEDIA_PROJECTION = 7301
        private const val STATE_LAUNCHED = "projection_picker_launched"

        fun createIntent(activity: Activity): Intent =
            Intent(activity, ProjectionConsentActivity::class.java)
    }
}
''', encoding='utf-8')

# Both phone and TV route projection consent through the dedicated foreground bridge.
main = pkg / 'MainActivity.kt'
s = main.read_text()
old = '        override fun launchProjection(intent: Intent) = projLauncher.launch(intent)\n'
new = '''        override fun launchProjection(intent: Intent) =
            projLauncher.launch(ProjectionConsentActivity.createIntent(this@MainActivity))
'''
if old not in s:
    die('MainActivity projection host anchor missing')
s = s.replace(old, new, 1)
main.write_text(s, encoding='utf-8')

tv = pkg / 'TvMainActivity.kt'
s = tv.read_text()
old = '        override fun launchProjection(intent: Intent) = projectionLauncher.launch(intent)\n'
new = '''        override fun launchProjection(intent: Intent) =
            projectionLauncher.launch(ProjectionConsentActivity.createIntent(this@TvMainActivity))
'''
if old not in s:
    die('TvMainActivity projection host anchor missing')
s = s.replace(old, new, 1)

# Paint the lightweight TV screen first; scene-library hydration and migration happen afterwards.
old = '''        renderLanguageAndScenes()
        render()
        startButton.requestFocus()

        // Non-critical legacy migration happens only after the first TV frame is already visible.
        window.decorView.post {
            runCatching { TranslationPlanStore.migrateLegacySavedPlans(this) }
        }
'''
new = '''        render()
        startButton.requestFocus()

        // First frame first. SharedPreferences/scene hydration is intentionally deferred.
        window.decorView.post {
            renderLanguageAndScenes()
            runCatching { TranslationPlanStore.migrateLegacySavedPlans(this) }
        }
'''
if old not in s:
    die('TV first-frame defer anchor missing')
s = s.replace(old, new, 1)
tv.write_text(s, encoding='utf-8')

# TV uses English default resources, so avoid AppCompat locale synchronization during process start.
app_file = pkg / 'LiveTranslateApp.kt'
s = app_file.read_text()
old = '''package com.xyq.livetranslate

import android.app.Application

class LiveTranslateApp : Application() {
    override fun onCreate() {
        super.onCreate()
        AppLocale.init(this)
    }
}
'''
new = '''package com.xyq.livetranslate

import android.app.Application
import android.content.res.Configuration

class LiveTranslateApp : Application() {
    override fun onCreate() {
        super.onCreate()
        val modeType = resources.configuration.uiMode and Configuration.UI_MODE_TYPE_MASK
        if (modeType == Configuration.UI_MODE_TYPE_TELEVISION) {
            // TV build defaults to English; avoid AppCompatDelegate locale disk/sync work on cold start.
            AppStrings.init(this)
        } else {
            AppLocale.init(this)
        }
    }
}
'''
if old not in s:
    die('LiveTranslateApp anchor missing')
s=s.replace(old,new,1)
app_file.write_text(s, encoding='utf-8')

# Strengthen the coordinator tests: no foreground service before an actual projection RESULT_OK.
test = app / 'src/test/java/com/xyq/livetranslate/ui/SessionCoordinatorProjectionRepeatTest.kt'
ts = test.read_text()
needle = '''        coordinator.beginPreparedSessionForTest(snap)
        assertEquals(1, host.projectionLaunches.size)

        coordinator.onProjectionResult(Activity.RESULT_OK, Intent("projection-one"))
'''
repl = '''        coordinator.beginPreparedSessionForTest(snap)
        assertEquals(1, host.projectionLaunches.size)
        assertEquals(0, host.startedForegroundServices.size)

        coordinator.onProjectionResult(Activity.RESULT_OK, Intent("projection-one"))
'''
if needle not in ts:
    die('projection test service-before-consent anchor missing')
ts=ts.replace(needle,repl,1)
test.write_text(ts,encoding='utf-8')

# Static gates.
mf=manifest.read_text()
checks={
    'bridge activity declared': '.ProjectionConsentActivity' in mf,
    'phone routes through bridge': 'ProjectionConsentActivity.createIntent(this@MainActivity)' in main.read_text(),
    'TV routes through bridge': 'ProjectionConsentActivity.createIntent(this@TvMainActivity)' in tv.read_text(),
    'bridge user-choice API34': 'MediaProjectionConfig.createConfigForUserChoice()' in bridge.read_text(),
    'bridge passes real result': 'setResult(resultCode, data)' in bridge.read_text(),
    'TV locale init deferred': 'AppStrings.init(this)' in app_file.read_text(),
    'TV scene hydration deferred': 'First frame first' in tv.read_text(),
}
for label,ok in checks.items():
    if not ok:
        die('projection/startup sanity check failed: '+label)
print('GreekLive hard projection-consent bridge + TV startup refinement complete')
