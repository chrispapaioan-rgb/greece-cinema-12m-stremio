# Replace byte-only queue with typed control/audio queue.
s=one(s,
'''    private val queue = LinkedBlockingDeque<ByteArray>()
    private val sentRing = ArrayDeque<ByteArray>()
''',
'''    private sealed interface Outbound {
        data class Audio(val bytes: ByteArray) : Outbound
        data class ActivityStart(val turnId: Long) : Outbound
        data class ActivityEnd(val turnId: Long) : Outbound
    }

    private val queue = LinkedBlockingDeque<Outbound>()
    private val sentRing = ArrayDeque<ByteArray>()
    private val sentTurnEnds = java.util.concurrent.ConcurrentLinkedQueue<Long>()
    private val nextManualTurnId = java.util.concurrent.atomic.AtomicLong(0L)
    @Volatile private var manualActivityOpen = false
    @Volatile private var manualActivityTurnId = 0L
''','Gemini queue fields')

old='''    /** 捕获线程调用：塞入一块 100ms/16k/mono 的 PCM。 */
    fun feedChunk(chunk: ByteArray) {
        if (!running.get()) return
        if (queue.size >= MAX_QUEUE) queue.pollFirst()
        queue.offerLast(chunk)
    }
'''
new='''    /** Capture-thread entry point: one PCM16/16k/mono chunk. */
    fun feedChunk(chunk: ByteArray) {
        if (!running.get()) return
        offerOutbound(Outbound.Audio(chunk))
    }

    fun activityStart() {
        if (!running.get() || !manualActivityDetection || manualActivityOpen) return
        val turnId = nextManualTurnId.incrementAndGet()
        manualActivityTurnId = turnId
        manualActivityOpen = true
        offerOutbound(Outbound.ActivityStart(turnId))
    }

    fun activityEnd(): Long? {
        if (!running.get() || !manualActivityDetection || !manualActivityOpen) return null
        val turnId = manualActivityTurnId.takeIf { it > 0L }
        manualActivityOpen = false
        manualActivityTurnId = 0L
        if (turnId != null) offerOutbound(Outbound.ActivityEnd(turnId))
        return turnId
    }

    private fun offerOutbound(item: Outbound) {
        while (queue.size >= MAX_QUEUE) {
            val it = queue.iterator()
            var removedAudio = false
            while (it.hasNext()) {
                if (it.next() is Outbound.Audio) {
                    it.remove()
                    removedAudio = true
                    break
                }
            }
            if (!removedAudio) break
        }
        queue.offerLast(item)
    }

    private fun restoreManualActivityAfterReconnect() {
        if (!manualActivityDetection || !manualActivityOpen || manualActivityTurnId <= 0L) return
        val turnId = manualActivityTurnId
        queue.removeIf { it is Outbound.ActivityStart && it.turnId == turnId }
        queue.offerFirst(Outbound.ActivityStart(turnId))
    }

    private fun finalizeOrphanedTurnEnds() {
        while (true) {
            val id = sentTurnEnds.poll() ?: break
            listener.onTurnComplete(id)
        }
    }
'''
