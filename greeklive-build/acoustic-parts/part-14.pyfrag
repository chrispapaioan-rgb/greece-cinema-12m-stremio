
# --- Google TV D-pad focus fix for the running Media screen.
page = app / 'src/main/res/layout/page_video.xml'
s = page.read_text()

# The subtitle transcript viewport is display-only on TV. Without this, NestedScrollView may become
# the focused "background" target and the remote can no longer reach Pause / Stop reliably.
s = one(
    s,
    '''        <androidx.core.widget.NestedScrollView
            android:id="@+id/videoSubtitleScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">
''',
    '''        <androidx.core.widget.NestedScrollView
            android:id="@+id/videoSubtitleScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:descendantFocusability="blocksDescendants"
            android:overScrollMode="never">
''',
    'TV running subtitle scroll focus',
)

s = one(
    s,
    '''                android:layout_weight="1"
                android:text="@string/btn_pause" />
''',
    '''                android:layout_weight="1"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusRight="@id/btnVideoStop"
                android:nextFocusUp="@id/btnVideoPause"
                android:text="@string/btn_pause" />
''',
    'TV pause focus navigation',
)

s = one(
    s,
    '''                android:layout_weight="1"
                android:text="@string/video_btn_stop"
''',
    '''                android:layout_weight="1"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@id/btnVideoPause"
                android:nextFocusUp="@id/btnVideoStop"
                android:text="@string/video_btn_stop"
''',
    'TV stop focus navigation',
)
page.write_text(s, encoding='utf-8')

# Running-state focus behavior: on a TV, transition into a live Media session with STOP focused.
# If focus somehow lands on a non-control child inside the running panel, reclaim it to STOP.
mode = pkg / 'ui/ModeHomePages.kt'
s = mode.read_text()

# Add Configuration import only once.
import_anchor = 'import android.content.Context\n'
if import_anchor not in s:
    die('ModeHomePages Context import anchor missing')
s = s.replace(
    import_anchor,
    import_anchor + 'import android.content.res.Configuration\n',
    1,
)

field_anchor = '''    private var renderedConfirmedTranslations: List<String>? = null
    private var silenceSinceMs = 0L
'''
field_repl = '''    private var renderedConfirmedTranslations: List<String>? = null
    private var silenceSinceMs = 0L
    private var wasActiveForTvFocus = false
'''
if field_anchor not in s:
    die('ModeHomeController fields anchor missing')
s = s.replace(field_anchor, field_repl, 1)

render_anchor = '''        if (mode == TranslationMode.VIDEO) renderOverlayPermission(status.overlayAllowed)
        if (!active) {
            silenceSinceMs = 0L
            return
        }
'''
render_repl = '''        if (mode == TranslationMode.VIDEO) renderOverlayPermission(status.overlayAllowed)
        if (!active) {
            silenceSinceMs = 0L
            wasActiveForTvFocus = false
            return
        }

        ensureTelevisionRunningFocus()
'''
if render_anchor not in s:
    die('ModeHomeController active render anchor missing')
s = s.replace(render_anchor, render_repl, 1)

# Replace confirmStop with a TV-aware dialog that focuses the destructive confirmation button.
start = s.find('    private fun confirmStop() {')
end = s.find('\n    private fun swapLanguages()', start)
if start < 0 or end < 0:
    die('confirmStop function anchors missing')
confirm = r'''    private fun confirmStop() {
        val label = if (mode == TranslationMode.INTERPRETATION) {
            context.getString(R.string.rt_mode_interpretation)
        } else {
            context.getString(R.string.rt_mode_video)
        }
        val message = if (mode == TranslationMode.INTERPRETATION) {
            context.getString(R.string.rt_dialog_stop_interp_message)
        } else {
            context.getString(R.string.rt_dialog_stop_video_message)
        }
        val dialog = MaterialAlertDialogBuilder(context)
            .setTitle(context.getString(R.string.rt_dialog_stop_mode_title, label))
            .setMessage(message)
            .setNegativeButton(context.getString(R.string.rt_action_cancel), null)
            .setPositiveButton(context.getString(R.string.rt_action_stop)) { _, _ ->
                toggleSession(captureMode)
            }
            .create()

        if (isTelevision()) {
            dialog.setOnShowListener {
                dialog.getButton(android.content.DialogInterface.BUTTON_POSITIVE)?.requestFocus()
            }
        }
        dialog.show()
    }

    private fun isTelevision(): Boolean {
        val modeType = context.resources.configuration.uiMode and Configuration.UI_MODE_TYPE_MASK
        return modeType == Configuration.UI_MODE_TYPE_TELEVISION
    }

    private fun ensureTelevisionRunningFocus() {
        if (!isTelevision() || mode != TranslationMode.VIDEO) return

        val firstEntry = !wasActiveForTvFocus
        wasActiveForTvFocus = true

        views.runningContent.post {
            val focusedInside = views.runningContent.findFocus()
            val validControl =
                focusedInside === views.pauseButton ||
                    focusedInside === views.stopButton ||
                    focusedInside === views.scrollLatestButton ||
                    focusedInside === views.openHistoryButton

            if (firstEntry || (focusedInside != null && !validControl)) {
                views.stopButton.isFocusable = true
                views.stopButton.isFocusableInTouchMode = true
                views.stopButton.requestFocus()
            }
        }
    }
'''
s = s[:start] + confirm + s[end:]
mode.write_text(s, encoding='utf-8')

# Static acceptance gates for the exact TV regression.
final_page = page.read_text()
final_mode = mode.read_text()
checks = {
    'subtitle scroll cannot steal focus': 'android:descendantFocusability="blocksDescendants"' in final_page,
    'pause points right to stop': 'android:nextFocusRight="@id/btnVideoStop"' in final_page,
    'stop points left to pause': 'android:nextFocusLeft="@id/btnVideoPause"' in final_page,
    'running session focuses stop': 'views.stopButton.requestFocus()' in final_mode,
    'TV stop dialog focuses positive': 'DialogInterface.BUTTON_POSITIVE' in final_mode,
}
for label, ok in checks.items():
    if not ok:
        die('TV focus sanity check failed: ' + label)
print('GreekLive Google TV running focus fix complete')
