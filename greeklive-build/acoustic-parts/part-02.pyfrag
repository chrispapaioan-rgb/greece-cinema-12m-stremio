SOURCES['SpeakerTurnGate.kt'] = 'package com.xyq.livetranslate\n\nimport java.util.ArrayDeque\nimport java.util.concurrent.LinkedBlockingDeque\nimport java.util.concurrent.TimeUnit\nimport java.util.concurrent.atomic.AtomicBoolean\n\n/**\n * Low-latency turn gate for 100 ms PCM16/16 kHz mono chunks (preserves the POCO-tested v0.1.10 transport).\n *\n * VAD decides speech vs non-speech. Speaker embeddings are computed only from speech-labelled\n * chunks. A hold-back buffer keeps enough future context so speaker identity can be stabilized\n * before audio is released to Gemini.\n *\n * v7 invariants:\n * - activityStart is emitted lazily, immediately before the first retained audio chunk.\n * - activityEnd returns a monotonically increasing Gemini turn id from the client.\n * - speaker boundaries carry the old turn id, so UI finalization can wait for exactly that\n *   turnComplete (or apply immediately if it already arrived).\n */\nclass SpeakerTurnGate(\n    private val embeddingEngine: SpeakerEmbeddingEngine,\n    private val speechActivityEngine: SpeechActivityEngine,\n    private val onAudio: (ByteArray) -> Unit,\n    private val onActivityStart: () -> Unit,\n    private val onActivityEnd: () -> Long?,\n    private val onSpeakerBoundary: (speakerId: String, afterTurnId: Long?) -> Unit,\n    private val tracker: SpeakerTurnTracker = SpeakerTurnTracker(),\n    private val config: Config = Config(),\n) : AutoCloseable {\n\n    data class Config(\n        val chunkMs: Int = 100,\n        val embeddingWindowSpeechChunks: Int = 12,\n        val analysisStepChunks: Int = 3,\n        val holdbackChunks: Int = 20,\n        val preRollChunks: Int = 4,\n        val maxInputQueueChunks: Int = 600,\n    ) {\n        init {\n            require(chunkMs > 0)\n            require(embeddingWindowSpeechChunks >= 6)\n            require(analysisStepChunks > 0)\n            require(holdbackChunks > embeddingWindowSpeechChunks + analysisStepChunks)\n            require(preRollChunks in 0 until holdbackChunks)\n        }\n    }\n\n    private data class Chunk(val seq: Long, val bytes: ByteArray, val speech: Boolean)\n\n    private val running = AtomicBoolean(true)\n    private val input = LinkedBlockingDeque<ByteArray>(config.maxInputQueueChunks)\n    private val pending = ArrayDeque<Chunk>()\n    private val preRoll = ArrayDeque<Chunk>()\n    private val worker = Thread(::runLoop, "speaker-turn-gate").apply { start() }\n\n    private var seq = 0L\n    private var activityOpen = false\n    private var outboundActivityOpen = false\n    private var activityStartedAfterGap = false\n\n    private var lastSpeechSeq = Long.MIN_VALUE\n    private var lastAnalysisSeq = Long.MIN_VALUE\n    private var lastStableCenterSeq = Long.MIN_VALUE\n    private var pendingBoundarySeq: Long? = null\n    private var lastEndedTurnId: Long? = null\n\n    /** Non-blocking AudioRecord entry point. */\n    fun feed(chunk: ByteArray) {\n        if (!running.get()) return\n        if (!input.offerLast(chunk.copyOf())) {\n            input.pollFirst()\n            input.offerLast(chunk.copyOf())\n        }\n    }\n\n    private fun runLoop() {\n        while (running.get() || input.isNotEmpty()) {\n            val bytes = try {\n                input.pollFirst(100, TimeUnit.MILLISECONDS)\n            } catch (_: InterruptedException) {\n                null\n            }\n            if (bytes != null) process(bytes)\n        }\n        flushAllAndEnd()\n    }\n\n    private fun process(bytes: ByteArray) {\n        seq++\n        val speech = runCatching { speechActivityEngine.isSpeech(bytes) }\n            .getOrElse { Pcm16.rms(bytes) >= 0.0045f }\n        val c = Chunk(seq, bytes, speech)\n\n        if (!activityOpen) {\n            preRoll.addLast(c)\n            trimPreRoll()\n            if (!speech) return\n\n            activityOpen = true\n            activityStartedAfterGap = tracker.currentSpeaker() != null\n            lastSpeechSeq = seq\n            lastAnalysisSeq = Long.MIN_VALUE\n            pendingBoundarySeq = null\n            while (preRoll.isNotEmpty()) pending.addLast(preRoll.removeFirst())\n        } else {\n            pending.addLast(c)\n            if (speech) lastSpeechSeq = seq\n        }\n\n        if (speech) maybeAnalyseSpeaker()\n        flushThrough(seq - config.holdbackChunks)\n\n        if (activityOpen && !speech && lastSpeechSeq != Long.MIN_VALUE) {\n            flushThrough(lastSpeechSeq)\n            pending.clear()\n            closeOutboundActivityIfNeeded()\n            activityOpen = false\n            activityStartedAfterGap = false\n            lastSpeechSeq = Long.MIN_VALUE\n            lastAnalysisSeq = Long.MIN_VALUE\n            pendingBoundarySeq = null\n            preRoll.clear()\n        }\n    }\n\n    private fun maybeAnalyseSpeaker() {\n        if (!activityOpen) return\n        if (lastAnalysisSeq != Long.MIN_VALUE && seq - lastAnalysisSeq < config.analysisStepChunks) return\n\n        val speechWindow = pending.takeLastSpeech(config.embeddingWindowSpeechChunks)\n        if (speechWindow.size < config.embeddingWindowSpeechChunks) return\n\n        val embedding = runCatching {\n            embeddingEngine.embedding(speechWindow.map { it.bytes })\n        }.getOrNull() ?: return\n\n        lastAnalysisSeq = seq\n        val centerSeq = speechWindow[speechWindow.size / 2].seq\n\n        when (val result = tracker.observe(embedding)) {\n            is SpeakerTurnTracker.Result.Initial -> {\n                pendingBoundarySeq = null\n                lastStableCenterSeq = centerSeq\n                activityStartedAfterGap = false\n            }\n\n            is SpeakerTurnTracker.Result.Same -> {\n                pendingBoundarySeq = null\n                lastStableCenterSeq = centerSeq\n                activityStartedAfterGap = false\n            }\n\n            is SpeakerTurnTracker.Result.Pending -> {\n                if (result.count <= 1 || pendingBoundarySeq == null) {\n                    pendingBoundarySeq = when {\n                        activityStartedAfterGap -> firstPendingSeq()\n                        lastStableCenterSeq != Long.MIN_VALUE ->\n                            ((lastStableCenterSeq + centerSeq + 1L) / 2L)\n                                .coerceAtLeast(firstPendingSeq())\n                        else -> speechWindow.first().seq.coerceAtLeast(firstPendingSeq())\n                    }\n                }\n            }\n\n            is SpeakerTurnTracker.Result.Switched -> {\n                val boundary = (pendingBoundarySeq ?: centerSeq)\n                    .coerceAtLeast(firstPendingSeq())\n\n                flushThrough(boundary - 1)\n                closeOutboundActivityIfNeeded()\n\n                // If this activity began after a silence, closeOutboundActivityIfNeeded() may do\n                // nothing because the previous turn was already ended. lastEndedTurnId therefore\n                // deliberately persists across the gap and still identifies the old speaker turn.\n                onSpeakerBoundary(result.to, lastEndedTurnId)\n\n                pendingBoundarySeq = null\n                lastAnalysisSeq = seq\n                lastStableCenterSeq = centerSeq\n                activityStartedAfterGap = false\n            }\n        }\n    }\n\n    private fun firstPendingSeq(): Long = pending.firstOrNull()?.seq ?: seq\n\n    private fun ensureOutboundActivityStart() {\n        if (outboundActivityOpen) return\n        onActivityStart()\n        outboundActivityOpen = true\n    }\n\n    private fun closeOutboundActivityIfNeeded(): Long? {\n        if (!outboundActivityOpen) return null\n        val turnId = onActivityEnd()\n        outboundActivityOpen = false\n        if (turnId != null && turnId > 0L) lastEndedTurnId = turnId\n        return turnId\n    }\n\n    private fun flushThrough(maxSeqInclusive: Long) {\n        while (pending.isNotEmpty()) {\n            val first = pending.first()\n            