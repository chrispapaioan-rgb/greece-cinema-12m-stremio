# --- Minimal TV exposure only. Do NOT touch MainActivity or MediaProjection host.
manifest = app / 'src/main/AndroidManifest.xml'
s = manifest.read_text()

root = '<manifest xmlns:android="http://schemas.android.com/apk/res/android">\n'
features = '''<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
'''
if root not in s:
    die('manifest root anchor missing')
s = s.replace(root, features, 1)

app_anchor = '''        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
'''
app_repl = '''        android:label="@string/app_name"
        android:banner="@mipmap/ic_launcher"
        android:localeConfig="@xml/locales_config"
'''
if app_anchor not in s:
    die('application label anchor missing')
s = s.replace(app_anchor, app_repl, 1)

service_anchor = '''        <service
            android:name="com.xyq.livetranslate.CaptureService"
'''
alias = '''        <activity-alias
            android:name="com.greeklive.subtitles.TvLauncher"
            android:targetActivity="com.xyq.livetranslate.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:banner="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

'''
if service_anchor not in s:
    die('service anchor missing')
s = s.replace(service_anchor, alias + service_anchor, 1)
manifest.write_text(s, encoding='utf-8')
print('Minimal TV manifest alias applied')
